{
  "name": "kh-kozak-desktop",
  "version": "1.0.0",
  "description": "KH Kozak Gaming Hub for Windows",
  "main": "main.cjs",
  "author": "KH Kozak",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.khkozak.gaminghub",
    "productName": "KH Kozak Gaming Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "KH-Kozak-Setup.exe"
    }
  }
}