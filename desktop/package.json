{
  "name": "kh-kozak-battle-hub",
  "version": "17.40.0",
  "description": "KOZAK NEXUS premium universal desktop app",
  "main": "main.cjs",
  "author": "KOZAK NEXUS",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.khkozak.battlehub",
    "productName": "KOZAK NEXUS",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
