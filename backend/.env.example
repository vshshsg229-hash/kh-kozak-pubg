PORT=3000
NODE_ENV=development
# PostgreSQL connection string from Neon/Supabase/Render. Keep private.
DATABASE_URL=
# Use a random secret with at least 32 characters; production host can generate it.
JWT_SECRET=
# Exact frontend origin, no trailing slash
FRONTEND_ORIGIN=https://vshshsg229-hash.github.io
# Optional server-only secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# AI provider: ollama or openai-compatible
AI_PROVIDER=ollama
# Use a reachable HTTPS Ollama endpoint for hosted backend deployment.
# Do not expose port 11434 directly to the public internet.
AI_BASE_URL=https://YOUR-PRIVATE-OLLAMA-HTTPS-ENDPOINT/v1
# Ollama's OpenAI-compatible client accepts a placeholder key; this is not a secret.
AI_API_KEY=ollama
AI_MODEL=llama3.2
# Request timeout in milliseconds (5000-90000)
AI_TIMEOUT_MS=45000
